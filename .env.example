# Copy to .env and fill real values. .env is gitignored — NEVER commit real secrets.
# Docker Compose reads .env automatically; export these into your shell for local mvn run.

# Postgres (compose)
POSTGRES_DB=braincache
POSTGRES_USER=braincache
POSTGRES_PASSWORD=change-me

# Spring datasource (backend) — must match Postgres creds above
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/braincache
SPRING_DATASOURCE_USERNAME=braincache
SPRING_DATASOURCE_PASSWORD=change-me

# JWT — generate a strong random secret >= 32 bytes, e.g. `openssl rand -base64 48`
JWT_SECRET=replace-with-openssl-rand-base64-48
JWT_TTL_HOURS=168

# SMTP — for daily review emails. Gmail: create an app password (not your login password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-gmail@gmail.com
SMTP_PASSWORD=your-16-char-app-password

# Review scheduling
REVIEW_INTERVALS_DAYS=1,2,4,8,16,32,64,128
REVIEW_EMAIL_CRON=0 0 7 * * *
REVIEW_EMAIL_FROM=brain-cache@localhost
